#jinja2: lstrip_blocks: True, trim_blocks: True
# {{ ansible_managed }}
[INCLUDES]
before = common.conf
[Definition]
# failed logins of the unifi web ui, as logged by the nginx in front of it (access log format "custom").
# Behind docker the unifi logs only show the gateway address, nginx sees the real client.
# fail2ban cuts the timestamp out of the line, so the brackets are empty here.
failregex = ^<HOST> - \S+ \[[^\]]*\] "POST /api/(auth/)?login HTTP/\d\.\d" (401|403)
ignoreregex =